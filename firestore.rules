rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Colección de Casos de Atención al Cliente de SICUREZZA XP
    match /cases/{caseId} {
      // Lectura y consulta para el sistema y reportes
      allow get, list: if true;

      // Creación de casos validando identificador único
      allow create: if isValidId(caseId);

      // Actualización de casos (gestión, cierre, archivado lógico)
      allow update: if isValidId(caseId);

      // Eliminación física permitida por el Administrador
      allow delete: if isValidId(caseId);
    }

    // Colección de prueba y diagnóstico de conectividad
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Colección de perfiles de usuario
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
